&lt;tr&gt;&lt;td class="panel" bgcolor="#67DEC6" style="background:#67DEC6;padding:24px 41px 30px;"&gt;&lt;table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="background:#FFFFFF;"&gt;
