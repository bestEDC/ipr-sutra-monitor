&lt;table role="presentation" cellpadding="0" cellspacing="0" border="0"&gt;&lt;tr&gt;
&lt;td class="ipr-d" bgcolor="#67DEC6" style="background:#67DEC6;border-radius:8px 8px 0 0;padding:6px 22px 2px;font-family:Teko,'Arial Narrow',Arial,sans-serif;font-size:20px;line-height:24px;font-weight:500;color:#1A1B4D;text-transform:uppercase;white-space:nowrap;"&gt;Movement on tracked measures&lt;/td&gt;
